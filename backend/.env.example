MONGO_URI=mongodb://localhost:27017
DB_NAME=cafe_db
# Secret key used to sign login JWTs (backend/routes/auth.py).
# Set this to a long random string in any real deployment - the
# fallback in code is only for first-run local dev.
JWT_SECRET=change-this-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
