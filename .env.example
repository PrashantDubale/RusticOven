# Copy this file to ".env" and fill in your real values.
# Never commit the real ".env" file to git — it holds secrets.

# If you're using MongoDB Atlas (cloud, free tier), it looks like:
# MONGO_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/
#
# If you're running MongoDB locally (installed on your own machine):
# MONGO_URI=mongodb://localhost:27017

MONGO_URI=mongodb://localhost:27017
DB_NAME=cafe_db
JWT_SECRET=change-this-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000

# Only used by local seed scripts, never commit the real value.
MANAGER_PASSCODE=change-this-local-only-value
